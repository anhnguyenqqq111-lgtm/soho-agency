{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/gioi-thieu",
      "destination": "/ve-soho/",
      "permanent": true
    },
    {
      "source": "/du-an",
      "destination": "/ket-qua/",
      "permanent": true
    },
    {
      "source": "/du-an/",
      "destination": "/ket-qua/",
      "permanent": true
    },
    {
      "source": "/tin-tuc",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/tin-tuc/:slug*",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/seo-website",
      "destination": "/seo-tong-the/",
      "permanent": true
    },
    {
      "source": "/quang-cao-google-ads",
      "destination": "/google-ads-shopping/",
      "permanent": true
    },
    {
      "source": "/dich-vu/meta-tiktok-ads",
      "destination": "/facebook-ads/",
      "permanent": true
    },
    {
      "source": "/dich-vu/meta-tiktok-ads/",
      "destination": "/facebook-ads/",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/chinh-sach-bao-mat/",
      "permanent": true
    },
    {
      "source": "/terms-conditions",
      "destination": "/dieu-khoan-su-dung/",
      "permanent": true
    },
    {
      "source": "/dich-vu/:slug([a-z0-9-]+)",
      "destination": "/:slug/",
      "permanent": true
    },
    {
      "source": "/dich-vu/:slug([a-z0-9-]+)/",
      "destination": "/:slug/",
      "permanent": true
    },
    {
      "source": "/blog/:slug([a-z0-9-]+)",
      "destination": "/:slug/",
      "permanent": true
    },
    {
      "source": "/blog/:slug([a-z0-9-]+)/",
      "destination": "/:slug/",
      "permanent": true
    }
  ]
}
